# Gemini AI Engine Credentials
USER_GEMINI_API_KEY="YOUR_PERSONAL_API_KEY"
GEMINI_API_KEY="YOUR_ENTERPRISE_GEMINI_API_KEY"

# Knowledge Vault OCR — OpenRouter (primary) → Groq (fallback) → Gemini (last resort)
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY"
OPENROUTER_VISION_MODEL="google/gemini-2.0-flash-exp:free"
GROQ_API_KEY="YOUR_GROQ_KEY"
GROQ_VISION_MODEL="qwen/qwen3.6-27b"

# Supabase Storage (Knowledge Vault PDF SSOT — no credit card required on free tier)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_KNOWLEDGE_BUCKET="knowledge-vault"
VITE_FIREBASE_PROJECT_ID="urjaflux-ai-os"
VITE_FIREBASE_DATABASE_ID="remixed-firestore-database-id"
VITE_FIREBASE_API_KEY="AIzaSy_Enterprise_Key_Mock"
VITE_FIREBASE_AUTH_DOMAIN="urjaflux-ai-os.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="urjaflux-ai-os.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# Observability & Logging
LOG_LEVEL="INFO"
ENABLE_TELEMETRY="true"
ENABLE_AUDIT_LOGGING="true"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
