    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "dxf-parser": "^1.1.2",
    "express": "^4.21.2",
    "fake-indexeddb": "^6.2.5",
    "firebase": "^12.16.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.1.200",
    "puppeteer": "^25.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
